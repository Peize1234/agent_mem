{
  "llm": {
    "provider": "deepseek",
    "config": {
      "model": "deepseek-v4-flash",
      "temperature": 0.2,
      "max_tokens": 2400
    }
  },
  "embedder": {
    "provider": "huggingface",
    "config": {
      "model": "BAAI/bge-small-zh-v1.5"
    }
  },
  "vector_store": {
    "provider": "qdrant",
    "config": {
      "embedding_model_dims": 512,
      "bm25_language": "zh"
    }
  },
  "midterm": {
    "enabled": true,
    "short_term_capacity": 4,
    "session_similarity_threshold": 0.5,
    "top_k_sessions": 5,
    "top_k_pages": 5,
    "max_total_pages": 5
  },
  "profile": {
    "enabled": true,
    "update_on_add": true
  },
  "background": {
    "enabled": true,
    "max_retries": 3,
    "poll_interval_seconds": 1.0
  },
  "agentic_retrieval": {
    "enabled": false,
    "max_iterations": 2,
    "max_tool_calls": 1,
    "max_queries": 3,
    "candidate_pool_size": 20,
    "max_total_results": 6,
    "max_tool_result_chars": 10000,
    "default_threshold": 0.1,
    "force_final_answer": true
  }
}
