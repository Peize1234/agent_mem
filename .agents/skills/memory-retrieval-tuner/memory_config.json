{
  "llm": {
    "provider": "deepseek",
    "config": {
      "model": "deepseek-v4-flash",
      "api_key": "${DEEPSEEK_API_KEY}",
      "max_tokens": 4096,
      "temperature": 0.1,
      "top_p": 0.1,
      "top_k": 1
    }
  },
  "benchmark_runtime": {
    "llm_observability": true,
    "deepseek_midterm_non_thinking": true,
    "deepseek_longterm_non_thinking": true
  },
  "embedder": {
    "provider": "huggingface",
    "config": {
      "model": "BAAI/bge-small-zh-v1.5",
      "embedding_dims": 512
    }
  },
  "vector_store": {
    "provider": "qdrant",
    "config": {
      "collection_name": "memory_retrieval_tuner_placeholder",
      "path": "/tmp/memory_retrieval_tuner_placeholder/qdrant",
      "embedding_model_dims": 512,
      "bm25_language": "zh",
      "on_disk": true
    }
  },
  "history_db_path": "/tmp/memory_retrieval_tuner_placeholder/history.db",
  "enforce_single_process": true,
  "llm_timeout_seconds": 180,
  "embedding_timeout_seconds": 120,
  "vector_store_timeout_seconds": 60,
  "entity_extraction_timeout_seconds": 120,
  "midterm": {
    "enabled": true,
    "short_term_capacity": 10,
    "session_similarity_threshold": 0.8,
    "embedding_similarity_weight": 0.7,
    "keyword_overlap_weight": 0.3,
    "top_k_sessions": 5,
    "top_k_pages": 5,
    "max_total_pages": 4,
    "midterm_candidate_pool_multiplier": 4,
    "midterm_rag_threshold": 0.1,
    "retention_half_life_turns": 168.0,
    "retention_floor": 0.2,
    "heat_alpha": 1.0,
    "heat_beta": 0.5,
    "heat_gamma": 1.0,
    "heat_recency_tau_turns": 24.0,
    "heat_modulation_min": 0.9,
    "heat_modulation_max": 1.1,
    "promotion_min_recall_count": 3,
    "promotion_heat_threshold": 5.0
  },
  "longterm_rag_threshold": 0.1,
  "longterm_top_k": 20,
  "longterm_candidate_pool_multiplier": 4,
  "entity_similarity_threshold": 0.5,
  "longterm_hybrid_preset": "balanced",
  "cross_session_longterm_rag_threshold": 0.1,
  "cross_session_retention_half_life_hours": 720.0,
  "cross_session_retention_floor": 0.2,
  "cross_session_reinforcement_gain": 0.25,
  "profile": {
    "enabled": true,
    "update_on_add": true,
    "extraction_mode": "explicit_and_inferred",
    "allow_dynamic_attributes": false,
    "max_input_user_messages": 4,
    "max_operations_per_update": 8,
    "llm_max_tokens": 4096
  },
  "background": {
    "enabled": true,
    "midterm_worker_count": 8,
    "longterm_worker_count": 8,
    "profile_worker_count": 4,
    "entity_extraction_worker_count": 4,
    "entity_extraction_pending_capacity": 32,
    "max_retries": 3,
    "retry_delays_seconds": [1.0, 2.0, 3.0],
    "poll_interval_seconds": 0.2,
    "lease_timeout_seconds": 180.0,
    "heartbeat_interval_seconds": 20.0,
    "watchdog_interval_seconds": 10.0,
    "max_stale_recoveries": 3,
    "shutdown_timeout_seconds": 60.0,
    "include_pending_in_context": true,
    "max_pending_context_messages": 20,
    "include_failed_in_context": false
  },
  "agentic_retrieval": {
    "enabled": true,
    "max_iterations": 2,
    "max_tool_calls": 1,
    "max_queries": 3,
    "candidate_pool_size": 20,
    "max_total_results": 6,
    "max_tool_result_chars": 10000,
    "force_final_answer": true
  }
}
