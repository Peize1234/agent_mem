{
  "benchmark": {
    "run_name": "recall_rebalanced_s001_s010",
    "reset_storage": true,
    "output_dir": "exp/results/recall_rebalanced_s001_s010",
    "random_seed": 42
  },
  "dataset": {
    "path": "exp/金融分析数据集_前10个Session长短期记忆再平衡.xlsx",
    "include_sheets": [
      "S001_贵州茅台_投研",
      "S002_贵州茅台_内审",
      "S003_比亚迪_风委",
      "S004_比亚迪_IR",
      "S005_宁德时代_合规",
      "S006_宁德时代_审委",
      "S007_美的集团_授信",
      "S008_美的集团_供应链",
      "S009_招商银行_并购",
      "S010_招商银行_采购"
    ],
    "max_sessions": 10,
    "max_turns_per_session": null
  },
  "storage": {
    "runtime_dir": "exp/runtime/recall_rebalanced_s001_s010",
    "collection_name": "recall_rebalanced_s001_s010"
  },
  "execution": {
    "session_concurrency": 10,
    "retrieval_timeout_seconds": 180,
    "add_timeout_seconds": 180,
    "background_job_timeout_seconds": 1800,
    "background_poll_interval_seconds": 0.2,
    "wait_strategy": "before_evaluation"
  },
  "memory": {
    "config_path": "exp/benchmark/memory_config.json",
    "llm_mode": "real",
    "infer": true,
    "profile_enabled": false,
    "profile_update_on_add": false
  },
  "retrieval": {
    "top_k": 5,
    "threshold": 0.1,
    "rerank": false
  },
  "evaluation": {
    "evaluate_only_long_range": true
  }
}
