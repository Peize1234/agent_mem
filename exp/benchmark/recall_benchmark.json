{
  "benchmark": {
    "run_name": "recall_full_100_sessions",
    "reset_storage": true,
    "output_dir": "exp/results/recall_full_100_sessions",
    "random_seed": 42
  },
  "dataset": {
    "path": "exp/enterprise_finance_memory_sessions_100_v3_realistic_2023_2025.xlsx",
    "include_sheets": [],
    "max_sessions": 4,
    "max_turns_per_session": null
  },
  "storage": {
    "runtime_dir": "exp/runtime/recall_full_100_sessions",
    "collection_name": "recall_full_100_sessions"
  },
  "execution": {
    "session_concurrency": 50,
    "retrieval_timeout_seconds": 180,
    "add_timeout_seconds": 180,
    "background_job_timeout_seconds": 1800,
    "background_poll_interval_seconds": 0.2,
    "wait_strategy": "before_evaluation"
  },
  "memory": {
    "config_path": "exp/benchmark/memory_config.json",
    "llm_mode": "real",
    "infer": true,
    "profile_enabled": false,
    "profile_update_on_add": false
  },
  "retrieval": {
    "top_k": 20,
    "threshold": 0.1,
    "rerank": false
  },
  "evaluation": {
    "evaluate_only_long_range": true
  }
}
